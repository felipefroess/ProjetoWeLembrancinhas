# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files & secrets (never commit passwords, tokens, or keys)
.env
.env*
!.env.example

# keys, certificates & credentials
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*credentials*.json
*service-account*.json
*serviceAccount*.json
.secrets/
secrets/
secrets.*
*.secrets.*
.htpasswd
.netrc
.npmrc

# local databases & dumps (keep supabase/schema.sql tracked)
*.sqlite
*.sqlite3
*.db
*.dump
*.bak

# vercel & supabase local
.vercel
.supabase/

# typescript
*.tsbuildinfo
next-env.d.ts

tunnel-*.txt
.neon
