# ========================================================================
# WE LEMBRANCINHAS - CONFIGURAÇÃO DE AMBIENTE
# ========================================================================
# Copie este arquivo para .env.local e preencha com suas credenciais reais.
# NENHUMA variável de banco deve possuir o prefixo NEXT_PUBLIC_!
# ========================================================================

# ------------------------------------------------------------------------
# 1. BANCO DE DADOS POSTGRESQL (NEON)
# ------------------------------------------------------------------------
# Obtenha sua Connection String no Dashboard do Neon (https://console.neon.tech).
# Recomendado: Utilizar o pooled connection string (com "-pooler" no host).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------
# 2. OBJECT STORAGE EXTERNO PARA IMAGENS (CLOUDFLARE R2 / S3 COMPATÍVEL)
# ------------------------------------------------------------------------
# As imagens são salvas em um bucket externo e o Neon armazena apenas a URL.
# Provedor ativo: 'r2' (Cloudflare R2), 's3' (AWS S3) ou 'local' (apenas para dev offline)
STORAGE_PROVIDER="r2"

# Cloudflare R2 / S3 Credentials
R2_ACCOUNT_ID="seu_cloudflare_account_id"
R2_ACCESS_KEY_ID="seu_access_key_id"
R2_SECRET_ACCESS_KEY="seu_secret_access_key"
R2_BUCKET_NAME="welembrancinhas-images"
# URL pública da CDN vinculada ao bucket (ex: domínio personalizado ou subdomínio r2.dev público)
R2_PUBLIC_URL="https://pub-exemplo.r2.dev"

# Caso opte por AWS S3 padrão (descomente e preencha):
# S3_ENDPOINT="https://s3.us-east-1.amazonaws.com"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY_ID="seu_s3_key"
# S3_SECRET_ACCESS_KEY="seu_s3_secret"
# S3_BUCKET_NAME="seu_bucket"
# S3_PUBLIC_URL="https://seu_bucket.s3.amazonaws.com"

# ------------------------------------------------------------------------
# 3. AUTENTICAÇÃO DO PAINEL ADMINISTRATIVO
# ------------------------------------------------------------------------
ADMIN_PASSWORD="sua_senha_segura_aqui"
ADMIN_SECRET_KEY="chave_secreta_para_assinatura_de_cookies_hmac_2026"

